# Normalise text files; Unity scenes, prefabs and assets are saved as text (Force Text).
* text=auto

# Binary assets: never diff or convert line endings.
*.png binary
*.jpg binary
*.jpeg binary
*.tif binary
*.tiff binary
*.tga binary
*.psd binary
*.exr binary
*.hdr binary
*.fbx binary
*.obj binary
*.glb binary
*.blend binary
*.wav binary
*.mp3 binary
*.ogg binary
*.mp4 binary
*.ttf binary
*.otf binary
*.dll binary
*.so binary
*.aar binary
*.jar binary
*.a binary
*.bytes binary
*.asset -text merge=unityyamlmerge diff
*.unity -text merge=unityyamlmerge diff
*.prefab -text merge=unityyamlmerge diff
*.mat -text merge=unityyamlmerge diff
*.anim -text merge=unityyamlmerge diff
*.controller -text merge=unityyamlmerge diff
*.meta -text merge=unityyamlmerge diff
