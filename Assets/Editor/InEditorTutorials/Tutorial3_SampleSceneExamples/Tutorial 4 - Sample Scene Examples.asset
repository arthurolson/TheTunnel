  m_Script: {fileID: 11500000, guid: 935228c0fd2628c4db5028980babef0b, type: 3}
  m_Name: NarrativeParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.NarrativeParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: 'The <b>Table UI</b> prefab is the root prefab for all UI used within the virtual table''s surface. This UI is built to be dynamic and it will enable specific menus contextually.


      The <b>Player UI Area (Script)</b> component defines which visual elements to toggle based on the Menu button state (open / collapsed.)


      Scroll down in the Inspector panel to find the <b>Player Options (Script)</b> component, which manages the entire Table UI.'
