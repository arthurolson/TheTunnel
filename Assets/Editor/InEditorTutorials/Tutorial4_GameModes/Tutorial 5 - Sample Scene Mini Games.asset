--- !u!114 &-1574702713776183357
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 935228c0fd2628c4db5028980babef0b, type: 3}
  m_Name: NarrativeParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.NarrativeParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: '<b>Sandbox Game Mode</b> is an open ended game mode that enables a <b>Network Object Dispenser</b> prefab that allows players to spawn and interact with <b>Networked Physics Interactables</b>. Some of these interactables have <b>special properties</b> such as a <b>Tube that applies force</b> and a <b>Torus that destroys objects</b>.

      This game mode shows an example of how players can spawn and destroy objects over the network and bring them between game modes.'
