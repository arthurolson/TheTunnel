  m_Name: NarrativeParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.NarrativeParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: "<b>Slingshot Game Mode</b> is a cooperative / competitive realtime game mode where players compete to hit the most balloons before being overwhelmed. Once 3 balloons reach the ceiling the game is over. \nThis game mode shows an example of a session based game mode with a replayable beginning and end."
